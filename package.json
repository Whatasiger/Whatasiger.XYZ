{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate --force && node tools/build-origin.js && node tools/minify.js",
    "clean": "hexo clean && node -e \"require('fs').rmSync('.origin-build',{recursive:true,force:true})\"",
    "deploy": "hexo deploy",
    "source:preview": "node tools/push-source.js",
    "source:publish": "node tools/push-source.js --publish",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-abbrlink2": "^1.0.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-front-matter": "^5.0.0",
    "hexo-generator-alias": "^1.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-pagination": "^3.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-symbols-count-time": "^0.7.1",
    "hexo-util": "^4.0.0",
    "js-yaml": "^4.3.2",
    "marked-footnote": "^1.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  }
}
