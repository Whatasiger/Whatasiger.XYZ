<script>
    (function() {
        // 核心修复：把普通的博客文章 (is_post) 和独立页面 (is_page) 都视为"阅读界面"
        var isArticle = <%= ((is_post() || is_page()) && page.layout !== 'gizmo' && page.layout !== 'stats' && page.layout !== 'soon') ? 'true' : 'false' %>; // Gizmo 陈列页不算阅读界面（与 layout.ejs 一致）
        var isFromArticle = sessionStorage.getItem("is_from_article") === "true";
        var theme = sessionStorage.getItem("theme");

        // 手机端锁定背景层高度（glint.css 的 --bg-lock-h），首帧前就定好：工具栏伸缩只改视口高度，
        // Via 这类 WebView 浏览器连 100lvh 也会跟着变，背景随之重算 cover 就会上下跳。
        // 同一宽度下取 100lvh、视口高度、屏幕高度中的最大者、只增不减（算上屏幕高度，工具栏第一次收起时也不必再长高）；宽度变化（转屏）时重新取
        try {
            if (window.matchMedia("(pointer: coarse)").matches && CSS.supports("height", "100lvh")) {
                var lockRoot = document.documentElement, lockWidth = -1, lockHeight = 0;
                var lockBgHeight = function () {
                    if (window.innerWidth !== lockWidth) {
                        lockWidth = window.innerWidth;
                        lockRoot.style.removeProperty("--bg-lock-h");
                        var sw = screen.width || 0, sh = screen.height || 0;
                        lockHeight = window.innerWidth < window.innerHeight ? Math.max(sw, sh) : Math.min(sw, sh);
                    }
                    var h = Math.max(lockHeight, window.innerHeight, parseFloat(getComputedStyle(document.body, "::before").height) || 0);
                    if (h === lockHeight && lockRoot.style.getPropertyValue("--bg-lock-h")) return;
                    lockHeight = h;
                    lockRoot.style.setProperty("--bg-lock-h", h + "px");
                };
                lockBgHeight();
                window.addEventListener("resize", lockBgHeight);
            }
        } catch (e) {}

        // 0. 立即应用字体设置，避免字体闪烁
        try {
            var SETTINGS_KEY = "whatasiger_reader_settings";
            var savedSettings = JSON.parse(localStorage.getItem(SETTINGS_KEY));
            var fontChoice = (savedSettings && savedSettings.fontFamily) ? savedSettings.fontFamily : "noto-sans-sc";
            var sourceHanFontStack = '"Noto Sans SC", "Source Han Sans SC", "Source Han Sans CN", "Noto Sans CJK SC", "思源黑体", "思源黑体 CN", "Microsoft YaHei", sans-serif';
            var systemFontStack = 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif';
            document.body.style.fontFamily = fontChoice === "noto-sans-sc" ? sourceHanFontStack : systemFontStack;
            if (fontChoice !== "noto-sans-sc") document.documentElement.classList.add("font-system"); // 顶栏不用内联的 Glint UI
            if (savedSettings && savedSettings.hideTodo) document.body.classList.add("hide-todo");
            // 阅读排版（行距 / 段距 / 行宽 / 缩进 / 宋体）：阅读页首帧前就按设置排好，glint.js 载入后照同样的值接管
            if (isArticle && savedSettings) {
                var bs = document.body.style;
                if (typeof savedSettings.lineHeight === "number") bs.setProperty("--reader-line-height", String(savedSettings.lineHeight));
                if (typeof savedSettings.paraSpacing === "number") bs.setProperty("--reader-para", savedSettings.paraSpacing + "em");
                if (typeof savedSettings.readWidth === "number") bs.setProperty("--reader-width", savedSettings.readWidth + "em");
                if (savedSettings.indent) bs.setProperty("--reader-indent", "2em");
                if (savedSettings.bodyFont === "serif") document.body.classList.add("reader-serif");
            }
            // 主题色：首帧前挂到 html 上，避免先闪一下默认的蓝
            if (savedSettings && savedSettings.accent && savedSettings.accent !== "blue") {
                document.documentElement.setAttribute("data-accent", savedSettings.accent);
            }
        } catch (e) {
            document.body.style.fontFamily = '"Noto Sans SC", "Source Han Sans SC", "Source Han Sans CN", "Noto Sans CJK SC", "思源黑体", "思源黑体 CN", "Microsoft YaHei", sans-serif';
        }

        // 0.1 背景可见度：与设置面板共用唯一数据源 whatasiger_reader_settings.bgOpacity
        var targetBgOpacity = 0.55; // 与 glint.js defaultSettings.bgOpacity=55 一致
        try {
            var readerSettings = JSON.parse(localStorage.getItem("whatasiger_reader_settings"));
            if (readerSettings && typeof readerSettings.bgOpacity === "number") {
                var v = readerSettings.bgOpacity;
                if (v >= 0 && v <= 100) targetBgOpacity = v / 100;
            }
        } catch (e) {
            // 忽略错误，使用默认 0.55
        }

        // 0.2 背景模糊度：设置里分两项——阅读页 bgBlur（默认 8px，CW 预告页也用它）与首页 homeBlur（默认 0，首页、归档等其余页面）
        var DEFAULT_ARTICLE_BLUR = 8;
        var savedBlur = DEFAULT_ARTICLE_BLUR, homeBlur = 0;
        try {
            if (readerSettings && typeof readerSettings.bgBlur === "number") {
                var bv = readerSettings.bgBlur;
                if (bv >= 0 && bv <= 20) savedBlur = bv;
            }
            if (readerSettings && typeof readerSettings.homeBlur === "number") {
                var hv = readerSettings.homeBlur;
                if (hv >= 0 && hv <= 20) homeBlur = hv;
            }
        } catch (e) {}
        var isBlurPage = isArticle || <%= page.layout === 'soon' ? 'true' : 'false' %>;   // 用阅读页模糊度的页面
        var targetBgBlur = isBlurPage ? savedBlur : homeBlur;
        // 初始（瞬间）模糊度：阅读页首帧就是最终模糊度（载入时主线程忙，过渡会被硬切）；
        // 其余页面从上一页的模糊度（sessionStorage glint-bg-blur）开始、两帧后过渡到自己的值：从阅读页回首页时变清晰，从首页进 CW 预告页时变模糊
        var lastBgBlur = NaN;
        try { lastBgBlur = parseFloat(sessionStorage.getItem("glint-bg-blur")); } catch (e) {}
        if (!(lastBgBlur >= 0 && lastBgBlur <= 20)) lastBgBlur = isFromArticle ? savedBlur : targetBgBlur;
        var initialBgBlur = isArticle ? savedBlur : lastBgBlur;
        try { sessionStorage.setItem("glint-bg-blur", String(targetBgBlur)); } catch (e) {}

        // 1. 初始状态：全面封印动画，防止页面刚加载时的任何闪烁
        document.body.classList.add("no-bg-transition");

        // 1.1 立即设置背景可见度和模糊度（封印状态，无动画）
        document.body.style.setProperty("--bg-opacity", String(targetBgOpacity));
        document.body.style.setProperty("--bg-blur", initialBgBlur + "px");

        // 2. 瞬间敲定日夜模式：本次浏览中点过日月按钮（sessionStorage theme-pick）就照它；否则按设置里的「日夜」
        //    （whatasiger_reader_settings.themeMode：dark 夜间，默认 / light 白天 / auto 跟随系统）。
        //    结果仍写回 sessionStorage theme，一叶等独立页面照旧读它；手机地址栏颜色（theme-color）跟着换
        try {
            var themeMode = (savedSettings && savedSettings.themeMode) || "dark";
            var themePick = sessionStorage.getItem("theme-pick");
            var isDark = themePick ? themePick !== "light"
                : themeMode === "auto" ? !window.matchMedia("(prefers-color-scheme: light)").matches
                : themeMode !== "light";
            theme = isDark ? "dark" : "light";
        } catch (e) {}
        document.body.classList.toggle("dark-theme", theme !== "light");
        try { sessionStorage.setItem("theme", theme === "light" ? "light" : "dark"); } catch (e) {}
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute("content", theme === "light" ? "#e9eff7" : "#0e0e10");

        // 3. 敲定刚进网页瞬间的背景状态
        if (isArticle) {
            // 阅读页：首帧即淡化（不论从哪来）。原先从主页来时在 rAF 里才挂、靠 0.5s 过渡变淡，
            // 但页面载入时主线程常被排版 / 脚本占住，过渡时间线照走，等能出下一帧时已走完，看起来就是亮背景硬切成灰
            document.body.classList.add("bg-faded");
        } else if (!isArticle && isFromArticle) {
            // 阅读页跳主页：必须先瞬间淡化，为后面的淡出动画做准备
            document.body.classList.add("bg-faded");
        }

        // 4. 更新记忆，留给下一次跳转使用
        sessionStorage.setItem("is_from_article", isArticle ? "true" : "false");

        // 5. 释放封印，并触发需要的丝滑动画
        requestAnimationFrame(function() {
            requestAnimationFrame(function() {
                // 解除动画封印
                document.body.classList.remove("no-bg-transition");

                // 背景可见度：与设置面板统一，不再在跳转时覆盖为固定值，保持当前 targetBgOpacity 即可
                document.body.style.setProperty("--bg-opacity", String(targetBgOpacity));

                // 背景模糊度：设置目标值，触发平滑过渡
                // 文章→文章时 initialBgBlur == targetBgBlur，此处赋值无变化，不触发动画
                document.body.style.setProperty("--bg-blur", targetBgBlur + "px");

                // 触发跨界面的过渡动画
                if (!isArticle && isFromArticle) {
                    // 阅读页跳主页：此时开始平滑变清晰
                    document.body.classList.remove("bg-faded");
                }
            });
        });
    })();
</script>
<header>
    <a href="/" class="header-logo"><span class="header-logo-name">Whatasiger</span><span class="header-logo-ver">Ciel</span></a>
    <div class="head-title">
        <a href="/" style="text-decoration: none; color: inherit; display: block; width: 100%; height: 100%;">
            <h4><%= config.title %></h4>
        </a>
    </div>
    <div class="head-action">
        <button type="button" class="toggle-btn" aria-label="导航" aria-controls="header-menu" aria-expanded="false"></button>
        <button type="button" class="light-btn" aria-label="切换日夜模式"></button>
        <button type="button" class="settings-btn" aria-label="阅读设置" aria-controls="reader-settings-panel" aria-expanded="false"></button>
        <button type="button" class="search-btn" aria-label="搜索文章" aria-controls="header-search" aria-expanded="false"></button>
    </div>

    <%# 所有页面都有搜索；结果在 header 外的 .search-panel 里（header 自带 backdrop-filter，嵌套的毛玻璃会失效）。逻辑见 glint.js setupSearch %>
    <div class="head-search" id="header-search">
        <label class="sr-only" for="local-search-input">搜索文章、CARRiER WAVE. 与页面（空格分隔多个词）</label>
        <input type="search" id="local-search-input" name="s" placeholder="标题 / 标签 / 正文" autocomplete="off" enterkeyhint="search"
               role="combobox" aria-autocomplete="list" aria-controls="local-search-result" aria-expanded="false">
    </div>
</header>
<%# 搜索面板：从搜索框下方长出来的毛玻璃卡片（glint.css「站内搜索」）。没输入时列出标签与归档入口 %>
<div class="search-panel" id="search-panel" inert aria-hidden="true">
    <div class="search-panel-inner">
        <div class="search-empty">
            <div class="search-empty-title"><i class="fa fa-tags" aria-hidden="true"></i>按标签浏览</div>
            <div class="search-chips">
                <% site.tags.sort('name').each(function (t) { %><a class="search-chip" href="<%- url_for(t.path) %>">#<%= t.name %><small><%= t.length %></small></a><% }) %>
                <a class="search-chip is-archive" href="<%- url_for('/archives/') %>"><i class="fa fa-archive" aria-hidden="true"></i>全部归档</a>
            </div>
            <p class="search-empty-tip">可搜文章、CARRiER WAVE.、页面与 Gizmo；空格分隔多个词，须全部命中</p>
        </div>
        <div class="search-status" role="status" aria-live="polite"></div>
        <div class="search-results" id="local-search-result" role="listbox" aria-label="搜索结果"><span class="search-pill" aria-hidden="true"></span></div>
        <div class="search-foot" aria-hidden="true">
            <span><kbd>↑</kbd><kbd>↓</kbd>选择</span><span><kbd>↵</kbd>打开</span><span><kbd>Esc</kbd>关闭</span><span class="search-foot-key"><kbd>/</kbd>随时唤起</span>
        </div>
    </div>
</div>
<%# 设置面板放在 header 外：header 自带 backdrop-filter，嵌套在内会让面板的毛玻璃失效 %>
<div class="settings-panel" id="reader-settings-panel" inert aria-hidden="true">
    <div class="settings-panel-inner">
        <%# 标题栏：右侧是「恢复默认」图标按钮（原先单独占一排） %>
        <div class="settings-panel-header">
            <i class="fa fa-sliders"></i>
            <span class="settings-panel-title">阅读设置</span>
            <button type="button" id="setting-reset-btn" class="settings-reset-btn" title="恢复默认" aria-label="恢复默认"><i class="fa fa-undo"></i></button>
        </div>
        <%# 两个分页：外观（界面 / 字体 / 开关 / 背景 / 主题色）与阅读（正文的字与排版）；强调块弹簧滑动，内容按方向滑入
            两页叠在同一格里（面板高度取两者较高者，切换时不跳）；阅读页默认打开「阅读」，其余页面打开「外观」，逻辑见 glint.js setupSettingsTabs %>
        <div class="settings-tabs" role="tablist" aria-label="设置分类" data-tab="look">
            <button type="button" role="tab" id="st-tab-look" data-tab="look" aria-controls="st-pane-look" aria-selected="true">外观</button>
            <button type="button" role="tab" id="st-tab-read" data-tab="read" aria-controls="st-pane-read" aria-selected="false">阅读</button>
        </div>
        <div class="settings-panes">
            <div class="settings-pane" id="st-pane-look" role="tabpanel" aria-labelledby="st-tab-look" data-pane="look">
                <div class="settings-group">
                    <%# 界面主题：切到 Origin 会跳到 Origin 界面的同一页（见 _partial/ui-switch.ejs） %>
                    <div class="settings-row">
                        <i class="fa fa-desktop"></i>
                        <span>界面</span>
                        <div class="settings-segment" id="setting-ui" data-value="glint" role="radiogroup" aria-label="界面">
                            <button type="button" role="radio" data-value="glint" aria-checked="true">Glint</button>
                            <button type="button" role="radio" data-value="origin" aria-checked="false">Origin</button>
                        </div>
                    </div>
                    <%# 日夜：夜间（默认）/ 白天 / 跟随系统；顶栏的日月按钮只在本次浏览中临时切换（header.ejs 开头首帧前判断） %>
                    <div class="settings-row">
                        <i class="fa fa-adjust"></i>
                        <span>日夜</span>
                        <div class="settings-segment is-three" id="setting-theme-mode" data-value="dark" role="radiogroup" aria-label="日夜">
                            <button type="button" role="radio" data-value="dark" aria-checked="true">夜间</button>
                            <button type="button" role="radio" data-value="light" aria-checked="false">白天</button>
                            <button type="button" role="radio" data-value="auto" aria-checked="false" title="跟随系统">自动</button>
                        </div>
                    </div>
                    <div class="settings-row">
                        <i class="fa fa-font"></i>
                        <span>字体</span>
                        <div class="settings-segment" id="setting-font-family" role="radiogroup" aria-label="字体">
                            <button type="button" role="radio" data-value="noto-sans-sc">思源黑体</button>
                            <button type="button" role="radio" data-value="system-default">系统默认</button>
                        </div>
                    </div>
                </div>
                <%# 开关：一排小胶囊（复选框藏在里面，亮起即开启） %>
                <div class="settings-chips">
                    <label class="settings-chip"><input type="checkbox" id="setting-immersive"><i class="fa fa-expand"></i>沉浸模式</label>
                    <label class="settings-chip"><input type="checkbox" id="setting-hide-todo"><i class="fa fa-list-ul"></i>隐藏首页 TODO</label>
                </div>
                <div class="settings-tiles">
                    <label class="settings-tile is-wide">
                        <span class="settings-tile-label"><i class="fa fa-eye"></i>背景可见度</span>
                        <input type="range" id="setting-bg-opacity" min="0" max="50" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-tint"></i>背景模糊<small>首页</small></span>
                        <input type="range" id="setting-home-blur" min="0" max="20" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-tint"></i>背景模糊<small>阅读页</small></span>
                        <input type="range" id="setting-bg-blur" min="0" max="20" step="any">
                    </label>
                </div>
                <%# 主题色：色相与 glint.css 第 0 节 html[data-accent] 一一对应；色块颜色取该主题的 --tc-soft 一级 %>
                <% var accents = [["blue", "天青", 247], ["lavender", "藤紫", 300], ["sakura", "樱粉", 355], ["mikan", "蜜柑", 62], ["wakakusa", "若草", 135], ["mint", "薄荷", 185]]; %>
                <div class="settings-group settings-accent-group">
                    <div class="settings-accent-head"><span>主题色</span><small id="setting-accent-name">天青</small></div>
                    <div class="settings-accent" id="setting-accent" role="radiogroup" aria-label="主题色">
                        <% accents.forEach(function (a) { %>
                            <button type="button" role="radio" data-value="<%= a[0] %>" data-name="<%= a[1] %>" aria-label="<%= a[1] %>" title="<%= a[1] %>" style="--sw: <%= a[0] === 'blue' ? '#8bb4e0' : 'oklch(0.756 0.078 ' + a[2] + ')' %>"></button>
                        <% }) %>
                    </div>
                </div>
            </div>
            <div class="settings-pane" id="st-pane-read" role="tabpanel" aria-labelledby="st-tab-read" data-pane="read">
                <div class="settings-group">
                    <%# 正文字体：黑体（随「外观」里的字体）或思源宋体（选中才加载，head.ejs / glint.js loadSerif） %>
                    <div class="settings-row">
                        <i class="fa fa-paragraph"></i>
                        <span>正文</span>
                        <div class="settings-segment" id="setting-body-font" role="radiogroup" aria-label="正文字体">
                            <button type="button" role="radio" data-value="sans">黑体</button>
                            <button type="button" role="radio" data-value="serif">宋体</button>
                        </div>
                        <label class="settings-chip is-small"><input type="checkbox" id="setting-indent"><i class="fa fa-indent"></i>缩进</label>
                    </div>
                </div>
                <div class="settings-tiles">
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-bold"></i>字重</span>
                        <input type="range" id="setting-font-weight" min="1" max="5" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-text-height"></i>字号</span>
                        <input type="range" id="setting-font-size" min="90" max="130" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-text-width"></i>字间距</span>
                        <input type="range" id="setting-letter-spacing" min="-2" max="8" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-align-justify"></i>行距</span>
                        <input type="range" id="setting-line-height" min="1.5" max="2.4" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-arrows-v"></i>段距</span>
                        <input type="range" id="setting-para-spacing" min="0" max="2" step="any">
                    </label>
                    <label class="settings-tile">
                        <span class="settings-tile-label"><i class="fa fa-arrows-h"></i>行宽</span>
                        <input type="range" id="setting-read-width" min="36" max="60" step="any">
                    </label>
                </div>
                <p class="settings-note">只在文章与独立页面对正文生效</p>
            </div>
        </div>
    </div>
</div>
<% var menuIcons = theme.menu_icons || {}; %>
<nav class="head-menu" id="header-menu" aria-label="主导航">
    <span class="head-menu-pill" aria-hidden="true"></span>
    <a href="<%= url_for() %>"<% if (is_home()) { %> class="current"<% } %>><i class="fa fa-<%= menuIcons['首页'] || 'home' %>"></i><span>首页</span></a>
    <% for (var i in theme.menu){
        // 归档：标签页、按年月的归档页也算它；导航收起时在卡片里与 Gizmo 并排成第三排（head-menu-wide 只是标记，小字不显示）
        var isArchive = /^\/archives\/?$/.test(theme.menu[i]);
        var cur = isArchive ? (is_archive() || is_tag()) : is_current(theme.menu[i]);
        var cls = [isArchive ? 'head-menu-wide' : '', cur ? 'current' : ''].filter(Boolean).join(' '); %>
        <a href="<%- url_for(theme.menu[i]) %>"<% if (cls) { %> class="<%= cls %>"<% } %>><i class="fa fa-<%= menuIcons[i] || 'circle-o' %>"></i><span><%= i %></span><% if (isArchive) { %><small>所有文章 · 标签</small><% } %></a>
    <% } %>
    <%# Gizmo 入口：只在收起式导航卡片里出现，与「归档」并排成第三排；桌面端的入口是首页右侧的叶片（gizmo-leaf.js） %>
    <a href="<%- url_for('/gizmo/') %>" class="head-menu-gizmo<% if (is_current('/gizmo/')) { %> current<% } %>"><i class="fa fa-leaf"></i><span>Gizmo</span><small>随手做的小玩意</small></a>
    <% if (is_home() && (site.data.backgrounds || []).length) { %>
    <%# 首页背景切换（导航收起时）：卡片最下方一整排缩略图；导航横排时入口在首页右上角（index.ejs）。不是 a，不进导航宽度的测量与强调框 %>
    <div class="head-menu-bg">
        <div class="head-menu-bg-title"><i class="fa fa-picture-o"></i><span>首页背景</span></div>
        <div class="bg-tiles" role="radiogroup" aria-label="首页背景"><%- partial("_partial/bg-tiles") %></div>
    </div>
    <% } %>
    <% if (is_home()) { %>
    <%# 首页沉浸（导航收起时）：卡片最下方一整排开关；导航横排时在首页右上角的 .bg-dock。不是 a，不进导航测量与强调框 %>
    <button type="button" class="head-menu-zen zen-switch" aria-pressed="false"><i class="fa fa-expand"></i><span>沉浸：只留背景</span></button>
    <% } %>
</nav>
<script>
    // 拖动选择（顶栏导航、设置面板的二选一与分页共用，glint.js 也用它）：在一排选项上按住拖动，强调框跟着指针走，
    // 松手时选中指针下最近的那一项；只是点一下照旧走各自的 click。拖动过后紧跟着的那次 click 会被吞掉，免得重复触发
    //   o.items()        → 可选的元素（按从左到右）
    //   o.move(x, item)  → 拖动中：x 是指针的 clientX，item 是离它最近的一项
    //   o.end(item)      → 松手（pointercancel 时 item 为 null，表示放弃）
    //   o.enabled()      → 可选；返回 false 时不接管
    window.glintDragPick = function (box, o) {
        var id = null, sx = 0, moved = false, swallowUntil = 0;
        function nearest(x) {          // 指针落在哪一项上就是哪一项，落在空隙里取中心最近的
            var best = null, bd = Infinity;
            o.items().forEach(function (el) {
                var r = el.getBoundingClientRect();
                if (!r.width) return;
                var d = x >= r.left && x <= r.right ? -1 : Math.abs(x - (r.left + r.right) / 2);
                if (d < bd) { bd = d; best = el; }
            });
            return best;
        }
        box.addEventListener("pointerdown", function (e) {
            if ((e.pointerType === "mouse" && e.button !== 0) || (o.enabled && !o.enabled())) return;
            id = e.pointerId; sx = e.clientX; moved = false;
        });
        box.addEventListener("pointermove", function (e) {
            if (e.pointerId !== id) return;
            if (!moved) {
                if (Math.abs(e.clientX - sx) < 6) return;
                moved = true;
                try { box.setPointerCapture(id); } catch (err) {}
                box.classList.add("is-dragging");
            }
            o.move(e.clientX, nearest(e.clientX));
        });
        function finish(e, cancel) {
            if (e.pointerId !== id) return;
            id = null;
            if (!moved) return;
            moved = false;
            box.classList.remove("is-dragging");
            swallowUntil = performance.now() + 350;
            o.end(cancel ? null : nearest(e.clientX));
        }
        box.addEventListener("pointerup", function (e) { finish(e, false); });
        box.addEventListener("pointercancel", function (e) { finish(e, true); });
        box.addEventListener("click", function (e) {
            if (performance.now() < swallowUntil && e.isTrusted) { e.preventDefault(); e.stopPropagation(); swallowUntil = 0; }
        }, true);
        box.addEventListener("dragstart", function (e) { e.preventDefault(); });   // 链接默认可拖出，会打断指针事件
    };

    // 顶栏导航是否收起：按钮居中排开时若会碰到左侧 Logo 或右侧搜索框 / 按钮，就收进汉堡菜单（html.nav-collapsed）
    // 紧跟在 nav 后同步执行，首帧即为正确布局；按钮宽度用 canvas 量文字算出，不必来回切换布局
    (function () {
        var root = document.documentElement;
        var nav = document.querySelector(".head-menu");
        var ctx = document.createElement("canvas").getContext("2d");
        var GAP = 24; // 与两侧元素至少留出的间距（px）
        var PAD = 0.85, SPACE = 0.15; // 与 glint.css 中 .head-menu > a 的左右 padding / margin-right 一致（em）

        function update() {
            var collapse = window.innerWidth < 600; // 手机端始终收起
            if (!collapse) {
                // 桌面端导航宽度：各按钮文字宽 + 胶囊左右留白 + 按钮间距
                var cs = getComputedStyle(nav);
                var fontSize = parseFloat(cs.fontSize);
                ctx.font = "600 " + cs.fontSize + " " + cs.fontFamily;
                var labels = nav.querySelectorAll(":scope > a:not(.head-menu-gizmo) span"); // Gizmo 不在横排导航里
                var width = (labels.length * PAD * 2 + (labels.length - 1) * SPACE) * fontSize;
                for (var i = 0; i < labels.length; i++) width += ctx.measureText(labels[i].textContent).width;

                var vw = root.clientWidth;
                var left = (vw - width) / 2, right = (vw + width) / 2;

                // 左侧 Logo 展开态位于 left: 1.5em（收起态会右移，故按展开态计算）
                var logo = document.querySelector(".header-logo");
                var logoRight = logo ? 1.5 * parseFloat(getComputedStyle(logo).fontSize) + logo.getBoundingClientRect().width : 0;

                // 右侧最靠左的元素（搜索框 / 日夜 / 设置按钮）
                var rightLimit = vw;
                var obstacles = document.querySelectorAll("header .head-search, header .light-btn, header .settings-btn");
                for (var j = 0; j < obstacles.length; j++) {
                    var r = obstacles[j].getBoundingClientRect();
                    if (r.width) rightLimit = Math.min(rightLimit, r.left);
                }
                collapse = left < logoRight + GAP || right > rightLimit - GAP;
            }
            if (root.classList.contains("nav-collapsed") !== collapse) {
                // 切换形态时直接跳到结果，不播放磁贴 ↔ 文字的过渡（字体加载后可能改判）
                root.classList.add("nav-switching");
                root.classList.toggle("nav-collapsed", collapse);
                if (!collapse) nav.classList.remove("active");
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () { root.classList.remove("nav-switching"); });
                });
            }
            // 布局或字体变了：强调框直接跳到位，不播放滑动
            if (!collapse) place(target, true);
        }

        // 桌面端导航强调框：平时停在当前页，悬停 / 聚焦时滑到所指项，离开后滑回（无当前页则淡出）
        var pill = nav.querySelector(".head-menu-pill");
        var current = nav.querySelector(":scope > a.current:not(.head-menu-gizmo)"); // Gizmo 长条在横排导航里是隐藏的，不能当强调框的落点
        var target = current;
        var leaveTimer = 0;

        function place(a, instant) {
            target = a;
            if (!a) { pill.classList.remove("is-on"); return; }
            // 从隐藏状态出现时原地浮现，不从上一次的位置滑过来
            if (instant || !pill.classList.contains("is-on")) {
                pill.classList.add("no-glide");
                instant = true;
            }
            pill.style.setProperty("--pill-x", a.offsetLeft + "px");
            pill.style.setProperty("--pill-w", a.offsetWidth + "px");
            pill.classList.toggle("is-current", a === current);
            pill.classList.add("is-on");
            if (instant) {
                void pill.offsetWidth;
                pill.classList.remove("no-glide");
            }
        }

        [].forEach.call(nav.querySelectorAll(":scope > a"), function (a) {
            a.addEventListener("pointerenter", function () {
                clearTimeout(leaveTimer);
                place(a);
            });
            // 两项之间有空隙，稍等一下再滑回，免得划过空隙时先回到当前页再折返
            a.addEventListener("pointerleave", function () {
                clearTimeout(leaveTimer);
                leaveTimer = setTimeout(function () { place(current); }, 90);
            });
            a.addEventListener("focus", function () { place(a); });
            a.addEventListener("blur", function () { place(current); });
        });

        // 拖动选择：按住在各项上拖，强调框跟着指针走（宽度随最近的一项），松手即前往那一项（收起成卡片时不接管）
        var items = [].slice.call(nav.querySelectorAll(":scope > a:not(.head-menu-gizmo)"));
        window.glintDragPick(nav, {
            items: function () { return items; },
            enabled: function () { return !root.classList.contains("nav-collapsed"); },
            move: function (x, a) {
                clearTimeout(leaveTimer);
                var navLeft = nav.getBoundingClientRect().left;
                var w = a ? a.offsetWidth : pill.offsetWidth;
                pill.classList.add("is-on");
                pill.classList.toggle("is-current", a === current);
                pill.style.setProperty("--pill-w", w + "px");
                pill.style.setProperty("--pill-x", Math.max(0, Math.min(nav.clientWidth - w, x - navLeft - w / 2)) + "px");
            },
            end: function (a) {
                if (!a) { place(current); return; }
                place(a);
                if (a !== current) a.click();
            }
        });

        update();
        window.addEventListener("resize", update);
        // 字体加载完成或在设置里切换字体后，文字宽度会变
        if (document.fonts) {
            document.fonts.ready.then(update);
            document.fonts.addEventListener("loadingdone", update);
        }
        // 设置里切换字体时写的是 body 的内联 font-family；body 的 style 还会被滑动条（--bg-blur、--reader-* 等）逐帧改写，
        // 只比对字体这一项的字符串（不触发样式计算），真的变了才重新量，拖滑动条时不再每帧强制重排
        var lastFont = document.body.style.fontFamily;
        new MutationObserver(function () {
            var f = document.body.style.fontFamily;
            if (f === lastFont) return;
            lastFont = f;
            update();
        }).observe(document.body, { attributes: true, attributeFilter: ["style"] });
    })();
</script>
