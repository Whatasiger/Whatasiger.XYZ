<head>
    <%- partial('_partial/ui-switch') %>
    <%
        // ===== 标题 =====
        let title = "没有标题";

        if(is_home()){
            title = config.title;
        }
        else{
            if(is_category()){
                title = page.category;
            }
            else if(is_archive()){
                title = page.year ? (
                    page.year + " 年" + (page.month ? " " + page.month + " 月" : "")
                ) : "归档";
            }
            else if(is_tag()){
                title = page.tag;
            }
            else if(is_post() || is_page() && page.title){
                title = page.title;
            }

            title = title + " - " + config.title;
        }

        // ===== 描述 / 关键词 / 封面 / 链接：用于 SEO + 社交分享 =====
        function _stripHtml(s) {
            return String(s || "").replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
        }

        let pageDescription = "";
        if (page.description) {
            pageDescription = _stripHtml(page.description);
        } else if (page.excerpt) {
            pageDescription = _stripHtml(page.excerpt);
        } else if (is_home() || is_archive() || is_category() || is_tag()) {
            pageDescription = config.description || "";
        } else if (page.content) {
            pageDescription = _stripHtml(page.content);
        }
        if (pageDescription.length > 200) {
            pageDescription = pageDescription.slice(0, 200) + "…";
        }

        let pageKeywords = "";
        if (page.tags && page.tags.length) {
            pageKeywords = page.tags.map(function (t) { return t.name; }).join(",");
        } else if (page.keywords) {
            pageKeywords = page.keywords;
        } else {
            pageKeywords = config.keywords || "";
        }

        let pageImage = "";
        if (page.cover) {
            pageImage = full_url_for(page.cover);
        } else if (theme.background) {
            pageImage = full_url_for(theme.background);
        }

        let pageUrl = full_url_for(page.path || "");
        let ogLocale = String(config.language || "zh-CN").replace("-", "_");
    %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title><%= title %></title>

    <%- favicon_tag("static/img/icon.png") %>
    <link rel="icon" href="/static/img/icon.png" sizes="192x192"/>
    <link rel="canonical" href="<%= pageUrl %>">

    <!-- 基本 SEO -->
    <meta name="description" content="<%= pageDescription %>">
    <% if (pageKeywords) { %><meta name="keywords" content="<%= pageKeywords %>"><% } %>
    <meta name="author" content="<%= config.author %>">
    <meta name="theme-color" content="#0e0e10">
    <meta name="referrer" content="no-referrer-when-downgrade">

    <!-- Open Graph -->
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
    <meta property="og:locale" content="<%= ogLocale %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <% if (pageImage) { %><meta property="og:image" content="<%= pageImage %>"><% } %>
    <% if (is_post()) { %>
    <meta property="article:published_time" content="<%= date_xml(page.date) %>">
    <% if (page.updated) { %><meta property="article:modified_time" content="<%= date_xml(page.updated) %>"><% } %>
    <% if (page.tags && page.tags.length) { page.tags.forEach(function (t) { %><meta property="article:tag" content="<%= t.name %>"><% }) } %>
    <% } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="<%= pageImage ? 'summary_large_image' : 'summary' %>">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <% if (pageImage) { %><meta name="twitter:image" content="<%= pageImage %>"><% } %>

    <!-- RSS / Atom（hexo-generator-feed 启用后可用） -->
    <% if (config.feed) {
        var feedTypes = Array.isArray(config.feed.type) ? config.feed.type : [config.feed.type || 'atom'];
        feedTypes.forEach(function (ft) {
            var fpath = (config.feed[ft + '_path']) || (ft === 'rss2' ? 'rss2.xml' : (ft === 'atom' ? 'atom.xml' : ''));
            if (!fpath) return;
            var fmime = ft === 'rss2' ? 'application/rss+xml' : 'application/atom+xml';
    %><link rel="alternate" type="<%= fmime %>" title="<%= config.title %>" href="<%- url_for('/' + fpath) %>"><%
        });
    } %>

    <!-- Sitemap（hexo-generator-sitemap 启用后可用） -->
    <% if (config.sitemap && config.sitemap.path) { %>
    <link rel="sitemap" type="application/xml" title="Sitemap" href="<%- url_for('/' + (Array.isArray(config.sitemap.path) ? config.sitemap.path[0] : config.sitemap.path)) %>">
    <% } %>

    <!-- 主题样式 -->
    <%- css("static/kico.css", "static/glint.css") %>
    <%- css("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css") %>

    <%
        // 文章有封面时整站背景换成封面（「关于网站」仍用主页背景）；直接写进样式，首帧就是封面，一镜到底的新页快照也能接上
        var bgImage = theme.background;
        if (is_post() && page.cover && page.title !== "关于网站") bgImage = page.cover;
    %>
    <% if (bgImage) { %>
    <style>body{ --page-bg-image: url(<%- bgImage %>) }</style>
    <% } %>
    <% if (is_post() && bgImage) { %>
    <%# 首页指针移上卡片时已按文章页的模糊度把这张图烤好（glint.js bgBake.prebake）：首帧就用烤好的图，背景层不挂实时的全屏模糊
       图、模糊度（设置里的 bgBlur，缺省 8，与 glint.js defaultSettings 一致）、视口尺寸都对得上才用；glint.js 载入后接管 %>
    <script>
        (function () {
            try {
                var p = JSON.parse(sessionStorage.getItem('glint-bg-prebake'));
                var s = JSON.parse(localStorage.getItem('whatasiger_reader_settings')) || {};
                var blur = typeof s.bgBlur === 'number' ? Math.max(0, Math.min(20, s.bgBlur)) : 8;
                if (!p || p.src !== <%- JSON.stringify(bgImage) %> || p.blur !== blur || p.w !== innerWidth || p.h !== innerHeight) return;
                var st = document.createElement('style');
                st.id = 'bg-prebake';
                st.textContent = 'body{--page-bg-image:url("' + p.url + '")}';
                document.head.appendChild(st);
                document.documentElement.classList.add('bg-prebaked');
            } catch (err) {}
        })();
    </script>
    <% } %>

    <!-- 思源黑体（Noto Sans SC）：国内镜像优先 + 本机字体名回退 -->
    <link rel="preconnect" href="https://fonts.loli.net">
    <link rel="preconnect" href="https://gstatic.loli.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="preload" as="style" href="https://fonts.loli.net/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet"
          href="https://fonts.loli.net/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap"
          media="print" onload="this.media='all'; this.onload=null;">
    <% if (is_home() || is_post()) { %>
    <%- partial('_partial/vt-flip') %>
    <% } %>
    <% if (is_home()) { %>
    <!-- 卡片标题用内联的子集字体，不再外链 Cormorant Garamond -->
    <%- partial('_partial/cw-title-font') %>
    <!-- 预渲染目录页：指针停在卡片上（或按下）时就在后台把它完整加载好，点击即刻切换、过渡立即开始，不必等网络与字体 -->
    <script type="speculationrules">{"prerender": [{"urls": ["<%- url_for('/carrier_wave/') %>"], "eagerness": "moderate"}]}</script>
    <!-- 文章卡片同样预渲染（指针停留 / 按下即开始）：点击后过渡立即开始，不必等文章页下载、解析、出首帧
         预渲染会执行文章页脚本，所以不蒜子等页面真正打开才加载计数（footer.ejs），评论等过渡结束（post-vt.ejs 的 vtSettled） -->
    <script type="speculationrules">{"prerender": [{"source": "document", "where": {"selector_matches": "a.post-item.card-style:not(.cw-card)"}, "eagerness": "moderate"}]}</script>
    <!-- 首页载入后先把各卡片文章页的 HTML 预取下来（只下载、不执行）：预渲染没来得及跑完就点下去时，也不必再等网络（实测 0.5–1.7s → 0.2–0.3s）；
         悬停 / 按下开始的预渲染同样直接用这份响应 -->
    <script type="speculationrules">{"prefetch": [{"source": "document", "where": {"selector_matches": "a.post-item.card-style:not(.cw-card)"}, "eagerness": "immediate"}]}</script>
    <!-- 卡片副题「载波·短篇辑」与目录页同用思源宋体；只取这几个字，字体文件很小 -->
    <link rel="stylesheet" href="https://fonts.loli.net/css2?family=Noto+Serif+SC:wght@300&text=<%- encodeURIComponent('载波短篇辑') %>&display=swap">
    <!-- 跨页面过渡只用于「首页 ↔ CARRiER WAVE.」与「首页 → 文章」（文章卡片一镜到底），其余跳转一律跳过 -->
    <style>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
    <script>
        (function () {
            var root = document.documentElement;
            var target = '<%- url_for("/carrier_wave/") %>';
            function norm(u) {
                try { return new URL(u, location.href).pathname.replace(/index\.html$/, ''); } catch (err) { return ''; }
            }
            window.addEventListener('pageswap', function (e) {
                var to = e.activation && e.activation.entry && e.activation.entry.url;
                // 给目录页留一份来源记录：它拿不到 navigation.activation.from 时据此判断是否从首页来
                try { sessionStorage.setItem('cw-vt-hop', JSON.stringify({ from: norm(location.href), to: to ? norm(to) : '', t: Date.now() })); } catch (err) {}
                if (!e.viewTransition) return;
                if (to && norm(to) !== target && leaveToPost(norm(to))) return;
                if (!to || norm(to) !== target) { e.viewTransition.skipTransition(); return; }
                // 快照前把卡片收回静止状态：悬停时标题字距变宽、载波鼓起变色，与目录页首屏对不上，交叉淡化时会出现重影
                root.classList.add('cw-leaving');
                alignWave();
            });
            // 卡片载波对准目录页的画布载波：形变时卡片被横向拉伸到首屏宽度，拉伸后的波长须等于画布波长（cw.js 中 58 / 窄屏 46），
            // 再平移到某个波峰，把它在新页中的横坐标交给目录页，画布按此定相位，两条波交接时严丝合缝
            function alignWave() {
                var box = document.querySelector('.cw-card-wave-box');
                var svg = box && box.querySelector('.cw-card-wave');
                var main = svg && svg.querySelector('.cw-card-strand:not(.is-ghost)');
                if (!main) return;
                var boxW = box.getBoundingClientRect().width;
                // 目录页首屏的载波轴：视口去掉滚动条，左右各留 24px（.cw-hero 的内边距）
                var axisL = 24, axisW = document.documentElement.clientWidth - 48;
                if (!boxW || axisW <= 0) return;
                var narrow = innerWidth < 640;
                var period = (narrow ? 46 : 58) * boxW / axisW;    // 卡片里应有的波长
                var width = period * 40;                           // SVG 共 40 个周期
                if (width < boxW + period) return;                 // 卡片过宽、平移后盖不满时放弃对齐
                // 第一个向上的波峰在路径的 10/1600（即 1/4 周期）处，左移 1/4 周期让它正对盒子左缘，形变后即落在载波轴左端
                svg.style.cssText = 'animation:none;width:' + width + 'px;transform:translateX(' + (-period / 4) + 'px)';
                main.style.transform = 'scaleY(' + ((narrow ? 4 : 5.5) / 3.6) + ')'; // 卡片振幅约 3.6px，放大到画布振幅
                try { sessionStorage.setItem('cw-wave-hop', JSON.stringify({ x: axisL, t: Date.now() })); } catch (err) {}
            }
            // 文章卡片一镜到底：只给被点的那张卡片挂名（名字须唯一），卡片放大成文章页的背景、标题飞到正文标题处
            // 卡片不在视口内（如用键盘从屏外聚焦后回车）就不做；样式见 glint.css「文章卡片一镜到底」
            function leaveToPost(path) {
                var cards = document.querySelectorAll('a.post-item.card-style:not(.cw-card)');
                for (var i = 0; i < cards.length; i++) {
                    if (norm(cards[i].href) !== path) continue;
                    var r = cards[i].getBoundingClientRect();
                    if (r.bottom <= 0 || r.top >= innerHeight) return false;
                    var title = cards[i].querySelector('.post-card-title span');
                    cards[i].classList.add('vt-active');
                    // 倾斜摆正（快照按平面形变；最多 2.5°，被放大的动作盖住看不出来）
                    cards[i].style.transform = '';
                    cards[i].style.viewTransitionName = 'post-cover';
                    if (title) title.style.viewTransitionName = 'post-title';
                    root.classList.add('post-leaving');
                    return true;
                }
                return false;
            }
            function resetPostCard() {
                root.classList.remove('post-leaving');
                var card = document.querySelector('.post-item.vt-active');
                if (!card) return;
                card.classList.remove('vt-active');
                card.style.viewTransitionName = '';
                var title = card.querySelector('.post-card-title span');
                if (title) title.style.viewTransitionName = '';
            }
            function resetWave() {
                var svg = document.querySelector('.cw-card-wave');
                if (svg) svg.style.cssText = '';
                var main = document.querySelector('.cw-card-strand:not(.is-ghost)');
                if (main) main.style.transform = '';
            }
            // 从目录页回来：整屏收回成卡片；卡片不在视口内（如恢复了滚动位置）就不做
            // 只在从往返缓存恢复时做：全新加载要等首页渲染，旧画面会先冻住，首帧布局也未定型，形变起止对不上
            var revealed = false;
            window.addEventListener('pagereveal', function (e) {
                var restored = revealed;
                revealed = true;
                root.classList.remove('cw-back', 'cw-leaving');
                resetWave();
                resetPostCard();
                if (!e.viewTransition) return;
                if (!restored) { e.viewTransition.skipTransition(); return; }
                var act = window.navigation && navigation.activation;
                var from = act && act.from && act.from.url;
                var card = document.querySelector('.post-item.cw-card');
                var r = card && card.getBoundingClientRect();
                if (!from || norm(from) !== target || !r || r.bottom <= 0 || r.top >= innerHeight) {
                    e.viewTransition.skipTransition();
                    return;
                }
                // cw-came-back 不随过渡结束移除：卡片的入场动画一旦恢复就会重播，造成落定后再闪一下
                root.classList.add('cw-back', 'cw-came-back');
                // 形变改为只动 transform，交给合成线程（见 _partial/vt-flip.ejs）
                vtFlip(e.viewTransition, {
                    'cw-stage': { el: '.post-item.cw-card' },
                    'cw-hero-wave': { el: '.cw-card-wave-box' },
                    'cw-hero-title': { old: 'auto', new: 'auto', el: '.cw-card-title' },
                    'cw-hero-sub': { old: 'auto', new: 'auto', el: '.cw-card-sub' }
                });
                e.viewTransition.finished.finally(function () { root.classList.remove('cw-back'); });
            });

            // 预取目录页及其阻塞渲染的字体样式表：跨页面过渡要求新页面在约 4 秒内完成首帧，否则浏览器静默放弃
            // 首页加载完后空闲时预取；首页还没加载完时，指针移上、按下或聚焦卡片就提前预取
            // 字体地址须与 _partial/carrier-wave-head.ejs 中的保持一致，否则预取的缓存用不上
            var warmed = false;
            function warm() {
                if (warmed) return;
                warmed = true;
                [target, 'https://fonts.loli.net/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300&family=Noto+Serif+SC:wght@300;400;500&display=swap']
                    .forEach(function (href) {
                        var l = document.createElement('link');
                        l.rel = 'prefetch';
                        l.href = href;
                        document.head.appendChild(l);
                    });
            }
            // 按下即有回应（所有卡片）：卡片微沉；文章卡片同时开始放大、模糊（触屏没有悬停），离场快照从这里接续
            // 抬起后保持按下状态直到离开本页；移出卡片、触摸转为滚动、带修饰键（新标签页打开）、从往返缓存回来时复原
            function pressable(card) {
                function release() { card.classList.remove('is-pressed'); }
                card.addEventListener('pointerdown', function (e) {
                    if (e.button === 0) card.classList.add('is-pressed');
                });
                // 触摸抬起时也会触发 pointerleave，只认鼠标
                card.addEventListener('pointerleave', function (e) {
                    if (e.pointerType === 'mouse') release();
                });
                card.addEventListener('pointercancel', release);
                card.addEventListener('click', function (e) {
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) release();
                });
                window.addEventListener('pageshow', release);
            }
            document.addEventListener('DOMContentLoaded', function () {
                Array.prototype.forEach.call(document.querySelectorAll('a.post-item.card-style:not(.cw-card)'), pressable);
                var card = document.querySelector('.post-item.cw-card');
                if (!card) return;
                ['pointerenter', 'pointerdown', 'touchstart', 'focus'].forEach(function (t) {
                    card.addEventListener(t, warm, { once: true, passive: true });
                });
                // CW 卡片按下时标题与载波还从悬停状态回落，与目录页首屏一致
                pressable(card);
                window.addEventListener('load', function () {
                    if (window.requestIdleCallback) requestIdleCallback(warm, { timeout: 3000 });
                    else setTimeout(warm, 1000);
                });
            });
        })();
    </script>
    <%- partial('_partial/vt-debug') %>
    <% } %>
    <% if (is_post()) { %>
    <%- partial('_partial/post-vt') %>
    <%- partial('_partial/vt-debug') %>
    <% } %>
    <noscript>
        <link rel="stylesheet" href="https://fonts.loli.net/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap">
    </noscript>

    <!-- 结构化数据：让搜索引擎更准确地理解文章 -->
    <% if (is_post()) {
        var ld = {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            "mainEntityOfPage": pageUrl,
            "headline": page.title || "",
            "datePublished": date_xml(page.date),
            "dateModified": date_xml(page.updated || page.date),
            "author": { "@type": "Person", "name": config.author },
            "publisher": { "@type": "Organization", "name": config.title }
        };
        if (pageImage) ld.image = pageImage;
        if (pageDescription) ld.description = pageDescription;
    %>
    <script type="application/ld+json"><%- JSON.stringify(ld) %></script>
    <% } else if (is_home()) { %>
    <script type="application/ld+json"><%- JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": config.title,
        "url": config.url,
        "description": config.description || "",
        "author": { "@type": "Person", "name": config.author }
    }) %></script>
    <% } %>
</head>
