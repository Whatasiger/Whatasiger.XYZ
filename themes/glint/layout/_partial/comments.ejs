<%
// 评论区开启条件：
// 1. 主题启用了 twikoo；
// 2. 当前页/文章没有显式关闭评论（front-matter: comments: false）。
var twikooCfg = theme.twikoo || {};
var commentsEnabled = twikooCfg.enable && page.comments !== false;
%>
<% if (commentsEnabled) { %>
<section class="post-comments">
    <div
        id="tcomment"
        data-env-id="<%= twikooCfg.envId || '' %>"
        data-lang="<%= twikooCfg.lang || 'zh-CN' %>"
        data-blogger-nick="<%= twikooCfg.blogger || theme.author || 'Whatasiger' %>"
        data-blogger-label="<%= twikooCfg.bloggerLabel || '博主' %>"
        data-blogger-avatar="<%= twikooCfg.bloggerAvatar || theme.author_avatar || '' %>"
        data-site-url="<%= config.url || '' %>"
        data-current-path="<%= page.path ? ('/' + page.path) : '' %>"
        data-twikoo-js="<%= twikooCfg.jsUrl || 'https://cdn.jsdelivr.net/npm/twikoo@1.7.7/dist/twikoo.min.js' %>"
        data-twikoo-path="<%= page.abbrlink ? ('/' + page.abbrlink + '/') : '' %>"></div>
    <%# 脚本外链（defer）：不再每页内联 27KB，换页走缓存；评论区快进入视口才加载 Twikoo %>
    <script src="<%- asset_url('static/comments.js') %>" defer></script>
</section>
<% } %>
