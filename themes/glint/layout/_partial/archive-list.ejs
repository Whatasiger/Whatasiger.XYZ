<section class="home-posts">
    <% if (is_home() && page.current === 1 && !cw_hidden()) {   /* carrier_wave.yml 的 hidden 为 true 时不显示 */
        var cwWave = 'M0 50';
        for (var cx = 0; cx < 1600; cx += 40) cwWave += ' Q' + (cx + 10) + ' 38 ' + (cx + 20) + ' 50 T' + (cx + 40) + ' 50';
    %>
        <%# 「新信号」：有读者上次打开目录页之后才接收的篇目时，卡片右上角亮一枚小点（只在读者打开过目录页之后才比较，见下方脚本） %>
        <a class="post-item card-style cw-card" href="<%- url_for('/carrier_wave/') %>" data-cw-tracks="<%= cw_published().join(',') %>">
            <span class="cw-card-new" aria-hidden="true">新信号</span>
            <div class="cw-card-wave-box" aria-hidden="true">
                <svg class="cw-card-wave" viewBox="0 0 1600 100" preserveAspectRatio="none">
                    <path class="cw-card-strand is-ghost" d="<%= cwWave %>"/>
                    <path class="cw-card-strand" d="<%= cwWave %>"/>
                </svg>
            </div>
            <div class="cw-card-body">
                <h2 class="cw-card-title">CARRiER WAVE.</h2>
                <p class="cw-card-sub">载波<i></i>短篇辑</p>
            </div>
        </a>
    <% } %>
    <% var cardIndex = 0; %>
    <% page.posts.each((post, i) => { %>
        <%# 整张卡片就是链接（中键 / 新标签页、首页的预取规则都认它）；一镜到底见 head.ejs %>
        <a class="post-item card-style" href="<%- url_for(post.path) %>">
            <%# 投影、高光与细边、摘要信息各是一层独立元素：一镜到底时各自成为过渡层，跟着卡片放大、途中渐隐（见 glint.css） %>
            <span class="post-card-shadow" aria-hidden="true"></span>
            <%# 封面原图与模糊层：两层真实元素，图片写在各自的内联 background-image 上（不经 CSS 变量，样式重算时不会被当成换了图而重绘）
               卡片用缩小的两档封面（card_cover，tools/card-covers.py 生成），按设备像素比挑；原图地址记在 data-cover，留给悬停时预烤文章页背景
               前两张直接写内联样式；其余先放在 data-bg-style，快滚到时才写上（下方脚本），首页不必一次下载全部封面 %>
            <% var coverUrl = post.cover || theme.background;
               var cc = card_cover(coverUrl);
               var bgStyle = cc.x1 === cc.x2 ? "background-image: url('" + cc.x1 + "');" : "background-image: url('" + cc.x1 + "'); background-image: " + cc.set + ";";
               var bgAttr = cardIndex++ < 2 ? 'style' : 'data-bg-style'; %>
            <div class="post-card-bg">
                <div class="post-card-zoom">
                    <div class="post-card-img" <%- bgAttr %>="<%- bgStyle %>" data-cover="<%- coverUrl %>"></div>
                    <div class="post-card-img post-card-soft" <%- bgAttr %>="<%- bgStyle %>"></div>
                    <div class="post-card-img post-card-blur" <%- bgAttr %>="<%- bgStyle %>"></div>
                </div>
            </div>

            <div class="post-card-overlay">
                <span class="post-card-light" aria-hidden="true"><span class="post-card-sheen"></span></span>
                <h2 class="post-card-title">
                    <span><%- post.title || '未命名' %></span>
                </h2>

                <div class="post-card-info">
                    <p class="post-card-description">
                        <%- post.description || strip_html(post.excerpt).substring(0, 60) + '...' || strip_html(post.content).substring(0, 60) + '...' %>
                    </p>
                    <div class="post-card-meta">
                        <span class="meta-date"><%- date(post.date, "YYYY-MM-DD") %></span>
                        <% if (post.tags && post.tags.length){ %>
                            <span class="meta-tags">
                                <% post.tags.forEach(function(tag){ %>
                                    #<%- tag.name %>
                                <% }) %>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>
        </a>
    <% }) %>
</section>
<%# 封面延后加载：data-bg-style 里的卡片在视口上下约 1.5 屏内就写上内联样式（首屏附近的这里同步写，首帧即有图），其余等滚近 %>
<script>
    (function () {
        var els = [].slice.call(document.querySelectorAll(".home-posts [data-bg-style]"));
        if (!els.length) return;
        function show(el) {
            var v = el.getAttribute("data-bg-style");
            if (v === null) return;     // 模糊层已由 glint.js 烤好换上
            el.setAttribute("style", v);
            el.removeAttribute("data-bg-style");
        }
        var near = innerHeight * 2.5, io = window.IntersectionObserver && new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (!en.isIntersecting) return;
                io.unobserve(en.target);
                show(en.target);
            });
        }, { rootMargin: "150% 0px" });
        els.forEach(function (el) {
            if (!io || el.getBoundingClientRect().top < near) show(el);
            else io.observe(el);
        });
    })();
</script>
<script>
    (function () {
        var card = document.querySelector(".cw-card[data-cw-tracks]");
        if (!card) return;
        var seen = null;
        try { seen = JSON.parse(localStorage.getItem("whatasiger_cw_seen")); } catch (e) {}
        if (!Array.isArray(seen)) return;
        var fresh = card.getAttribute("data-cw-tracks").split(",").filter(function (s) { return s && seen.indexOf(s) === -1; });
        if (!fresh.length) return;
        card.classList.add("has-new");
        card.setAttribute("aria-label", "CARRiER WAVE.（有 " + fresh.length + " 篇新接收的信号）");
    })();
</script>
