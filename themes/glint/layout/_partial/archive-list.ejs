<section class="home-posts">
    <% if (is_home() && page.current === 1) {
        var cwWave = 'M0 50';
        for (var cx = 0; cx < 1600; cx += 40) cwWave += ' Q' + (cx + 10) + ' 38 ' + (cx + 20) + ' 50 T' + (cx + 40) + ' 50';
    %>
        <a class="post-item card-style cw-card" href="<%- url_for('/carrier_wave/') %>">
            <div class="cw-card-wave-box" aria-hidden="true">
                <svg class="cw-card-wave" viewBox="0 0 1600 100" preserveAspectRatio="none">
                    <path class="cw-card-strand is-ghost" d="<%= cwWave %>"/>
                    <path class="cw-card-strand" d="<%= cwWave %>"/>
                </svg>
            </div>
            <div class="cw-card-body">
                <h2 class="cw-card-title">CARRiER WAVE.</h2>
                <p class="cw-card-sub">载波<i></i>短篇辑</p>
            </div>
        </a>
    <% } %>
    <% page.posts.each((post, i) => { %>
        <% if (post.title !== '关于网站') { %>
        <%# 整张卡片就是链接（中键 / 新标签页、首页的预取规则都认它）；一镜到底见 head.ejs %>
        <a class="post-item card-style" href="<%- url_for(post.path) %>">
            <%# 封面原图与模糊层：两层真实元素，图片写在各自的内联 background-image 上（不经 CSS 变量，样式重算时不会被当成换了图而重绘） %>
            <% var coverUrl = post.cover || theme.background; %>
            <div class="post-card-bg">
                <div class="post-card-zoom">
                    <div class="post-card-img" style="background-image: url('<%- coverUrl %>');"></div>
                    <div class="post-card-img post-card-soft" style="background-image: url('<%- coverUrl %>');"></div>
                    <div class="post-card-img post-card-blur" style="background-image: url('<%- coverUrl %>');"></div>
                </div>
            </div>

            <div class="post-card-overlay">
                <span class="post-card-sheen" aria-hidden="true"></span>
                <h2 class="post-card-title">
                    <span><%- post.title || '未命名' %></span>
                </h2>

                <div class="post-card-info">
                    <p class="post-card-description">
                        <%- post.description || strip_html(post.excerpt).substring(0, 60) + '...' || strip_html(post.content).substring(0, 60) + '...' %>
                    </p>
                    <div class="post-card-meta">
                        <span class="meta-date"><%- date(post.date, "YYYY-MM-DD") %></span>
                        <% if (post.tags && post.tags.length){ %>
                            <span class="meta-tags">
                                <% post.tags.forEach(function(tag){ %>
                                    #<%- tag.name %>
                                <% }) %>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>
        </a>
        <% } %>
    <% }) %>
</section>
