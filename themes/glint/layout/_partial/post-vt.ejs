<%# 文章页一侧的「文章卡片一镜到底」：只接从首页（含分页）卡片进来的这一次，其余跳转一律跳过
   首页一侧见 head.ejs，过渡编排见 glint.css「文章卡片一镜到底」 %>
<%# 首帧要等到正文标题解析完：否则首帧时 .vt-cover 与标题还不存在，新页快照里配不上对，只剩整页淡入淡出 %>
<link rel="expect" href="#vt-post-title" blocking="render">
<style>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
<script>
    (function () {
        var root = document.documentElement;
        var home = '<%- url_for("/") %>';
        function norm(u) {
            try { return new URL(u, location.href).pathname.replace(/index\.html$/, ''); } catch (err) { return ''; }
        }
        function isHome(p) {
            return p === home || (p.indexOf(home + 'page/') === 0);
        }
        // 来源页：优先用 navigation.activation；拿不到时退回首页在 pageswap 里写下的记录（cw-vt-hop）
        function fromHome() {
            var act = window.navigation && navigation.activation;
            var from = act && act.from && act.from.url;
            if (from) return isHome(norm(from));
            try {
                var hop = JSON.parse(sessionStorage.getItem('cw-vt-hop'));
                return !!hop && Date.now() - hop.t < 10000 && hop.to === norm(location.href) && isHome(hop.from);
            } catch (err) { return false; }
        }
        // 从搜索结果 / 归档时间线点进来（_partial/title-hop.ejs 写下的 title-hop）
        function fromTitleHop() {
            try {
                var hop = JSON.parse(sessionStorage.getItem('title-hop'));
                if (!hop || hop.to !== norm(location.href) || Date.now() - hop.t > 10000) return false;
                sessionStorage.removeItem('title-hop');
                return true;
            } catch (err) { return false; }
        }
        // 过渡结束的信号：评论（Twikoo）等重活等它落定再开始，免得在过渡中途占住主线程（见 _partial/comments.ejs）
        var settle;
        window.vtSettled = new Promise(function (r) { settle = r; });
        if (!('onpagereveal' in window)) settle();
        window.addEventListener('pagereveal', function (e) {
            if (!e.viewTransition) { settle(); return; }
            if (fromTitleHop()) {
                // 只有标题一组：旧页的标题文字飞到正文标题处，页面整体交叉淡化（glint.css「标题一镜到底」）
                e.viewTransition.finished.finally(settle);
                if (window.pageReveal) pageReveal();
                root.classList.add('vt-from-hop', 'vt-card-in');
                vtFlip(e.viewTransition, { 'post-title': { old: 'auto', new: 'auto', el: '#vt-post-title' } });
                e.viewTransition.finished.finally(function () { root.classList.remove('vt-from-hop'); });
                return;
            }
            if (!fromHome()) { e.viewTransition.skipTransition(); settle(); return; }
            e.viewTransition.finished.finally(settle);
            // 不等字体（head.ejs 的 page-loading）：首帧须有正文标题与卡片标题配对
            if (window.pageReveal) pageReveal();
            // vt-card-in 不随过渡结束移除：标题区的入场动画一旦恢复就会重播
            root.classList.add('vt-from-card', 'vt-card-in');
            // 背景已是烤好模糊的图（首页预烤 → head.ejs 挂 bg-prebaked；或预渲染中 glint.js 已烤好 → body.bg-baked）：
            // .vt-cover 画上它，作为封面组新页一侧的模糊层（glint.css「文章卡片一镜到底」）；否则是空层，只放大卡片快照
            var live = false;
            try {
                var b = document.body;
                live = (root.classList.contains('bg-prebaked') || b.classList.contains('bg-baked')) &&
                    parseFloat(getComputedStyle(b).getPropertyValue('--bg-blur')) > 0;
            } catch (err) {}
            root.classList.toggle('vt-cover-live', live);
            // 封面与标题的形变只动 transform，交给合成线程：文章页正在加载时主线程再忙也不掉帧（见 _partial/vt-flip.ejs）
            vtFlip(e.viewTransition, {
                'post-cover': live ? { old: 'cover', new: 'cover', radius: 24 } : { old: 'cover' },
                'post-shadow': { follow: 'post-cover', how: 'box' },
                'post-light': { follow: 'post-cover', how: 'box' },
                'post-info': { follow: 'post-cover', how: 'content' },
                'post-title': { old: 'auto', new: 'auto', el: '#vt-post-title' }
            });
            e.viewTransition.finished.finally(function () { root.classList.remove('vt-from-card', 'vt-cover-live'); });
        });
        // 离开文章页：不做过渡（从搜索结果点进另一篇文章除外，见 _partial/title-hop.ejs）
        window.addEventListener('pageswap', function (e) {
            if (e.viewTransition && !takeTitleHop(e)) e.viewTransition.skipTransition();
        });
    })();
</script>
