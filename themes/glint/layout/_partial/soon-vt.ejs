<%# CW 预告页一侧的「预告卡片一镜到底」：只接从首页点预告卡片进来的这一次（首页在 pageswap 里挂 soon-leaving 并写下 soon-hop），其余跳转一律跳过
   卡片本身沉成拼贴里的夜空底片 .soon-sheet（一边放大一边转到贴歪的角度），左上角的胶带、载波、标题跟着各就各位，
   手写的 Coming soon 从卡片上飞到纸条上、由奶白墨迹换成深色墨水；其余碎片（色卡、刻度条、邮票、邮戳）在形变后半程才依次落下
   编排见 glint.css「CW 预告页」末尾；形变走 vtFlip（合成线程，支持旋转），卡片侧的挂名见 glint.css 预告卡片一节 %>
<%# 首帧要等到落点解析完（手写字在画板最末），否则新页快照里配不上对 %>
<link rel="expect" href="#soon-hand" blocking="render">
<style>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
<script>
    (function () {
        var root = document.documentElement;
        window.addEventListener('pagereveal', function (e) {
            if (!e.viewTransition) return;
            var hop = 0;
            try { hop = +sessionStorage.getItem('soon-hop') || 0; sessionStorage.removeItem('soon-hop'); } catch (err) {}
            if (Date.now() - hop > 10000) { e.viewTransition.skipTransition(); return; }
            // soon-from-card：过渡期间给落点挂上过渡名（过渡结束撤掉，免得之后离页时被多截几张快照）
            // soon-scraps-wait：其余碎片先藏着，撤掉后它们的落下动画从头播（过渡中途撤，不碰过渡名）
            // soon-card-in 不随过渡结束移除：它关掉了底片 / 纸条 / 手写字自带的入场动画（带名元素须静止），一旦恢复就会重播
            root.classList.add('soon-from-card', 'soon-scraps-wait', 'soon-card-in');
            var shown = false;
            function show() {
                if (shown) return;
                shown = true;
                root.classList.remove('soon-scraps-wait');
            }
            // 碎片在底片快落定时开始落下（新页快照是实时的，过渡中就看得到）；过渡被跳过或提前结束时立即显示
            e.viewTransition.ready.then(function () { setTimeout(show, 380); }, show);
            e.viewTransition.finished.finally(function () { show(); root.classList.remove('soon-from-card'); });
            vtFlip(e.viewTransition, {
                'soon-sheet': { el: '.soon-sheet' },
                'soon-tape': { el: '.soon-tape.is-a' },
                'soon-wave': { el: '.soon-sheet-wave' },
                'soon-title': { old: 'auto', new: 'auto', el: '.soon-title' },
                'soon-hand': { old: 'auto', new: 'auto', el: '#soon-hand' }
            });
        });
        // 离开预告页：不做过渡（从搜索结果点进文章除外，见 _partial/title-hop.ejs）
        window.addEventListener('pageswap', function (e) {
            if (e.viewTransition && !takeTitleHop(e)) e.viewTransition.skipTransition();
        });
    })();
</script>
