<footer>
    <div class="wrap min">
        <%# Gizmo 陈列页只留版权信息，不要最新文章 / 时光机 / 标签云三张卡片 %>
        <% if (page.layout !== 'gizmo') { %>
        <section class="widget">
            <div class="footer-grid">
                <div class="footer-card">
                    <h3 class="footer-card-title title-recent">最新文章<span class="footer-card-sub">Recent</span></h3>
                    <%- list_posts() %>
                </div>
                <div class="footer-card">
                    <h3 class="footer-card-title title-date">时光机<span class="footer-card-sub">Archive</span></h3>
                    <%- list_archives({ show_count: false, format: 'YYYY 年 M 月' }) %>
                </div>
                <div class="footer-card">
                    <h3 class="footer-card-title title-tags">标签云<span class="footer-card-sub">Tags</span></h3>
                    <div class="footer-tags"><%- tagcloud({ min_font: 13, max_font: 17, unit: 'px' }) %></div>
                    <p class="footer-card-note">共 <%= site.posts.length %> 篇文章 · <%= site.tags.length %> 个标签</p>
                </div>
            </div>
        </section>
        <% } %>
        <section class="sub-footer">
            <p>© <%= date(new Date, "YYYY") %> <a href="<%= url_for() %>"><%= config.title %></a>. All Rights Reserved. Theme Glint, based on <a href="https://github.com/Dreamer-Paul/Hingle" target="_blank" rel="nofollow">Hingle</a>.</p>
        </section>
    </div>
</footer>

<%# 目录开关 .toggle-list 由 glint.js 插入此处（CSS 已隐藏） %>
<div class="buttons"></div>

<script src="<%- asset_url('static/kico.js') %>"></script>
<script src="<%- asset_url('static/glint.js') %>"></script>

<script>var glint = new Glint(<%- JSON.stringify(theme.config) %>);</script>
<%# 不蒜子：页面被预渲染（首页悬停卡片时）时先不加载，等真正打开再计数，否则没点进去也会多计一次 %>
<script>
    (function () {
        function load() {
            var s = document.createElement('script');
            s.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
            s.async = true;
            document.body.appendChild(s);
        }
        if (document.prerendering) document.addEventListener('prerenderingchange', load, { once: true });
        else if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load);
        else load();
    })();
</script>