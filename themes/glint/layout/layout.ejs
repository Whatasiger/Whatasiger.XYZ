<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
  <%- partial("_partial/head") %>
  <%
    // 有目录的阅读页在服务端就挂上 has-trees（正文让出目录的位置），首帧即是最终版面：
    // 否则要等 glint.js 的 tree() 才挂，正文标题在一镜到底途中横移。判断与 tree() 一致：正文里脚注之外有标题
    var hasTrees = (is_post() || is_page()) && /<h[1-6][\s>]/i.test(String(page.content || '').replace(/<section class="footnotes"[\s\S]*?<\/section>/gi, ''));
  %>
  <body class="dark-theme <%- (is_post() || is_page()) ? 'post-page' : '' %><%- hasTrees ? ' has-trees' : '' %>">
    <%- partial("_partial/header") %>
    <%- body %>
    <%- partial("_partial/footer") %>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const searchBox = document.querySelector('.head-search');
        const searchBtn = document.querySelector('.search-btn');

        if (searchBox && searchBtn) {
          // 监听整个网页的点击事件
          document.addEventListener('click', function(event) {
            // 如果搜索框当前是展开状态 (active)
            if (searchBox.classList.contains('active')) {
              // 且手指点击的位置既不在搜索框内部，也不在放大镜图标上
              if (!searchBox.contains(event.target) && !searchBtn.contains(event.target)) {
                // 移除 active 状态，触发 CSS 动画收回搜索框
                searchBox.classList.remove('active');
              }
            }
          });
        }
      });
    </script>
  </body>
</html>
