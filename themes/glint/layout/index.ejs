<main>
    <div class="wrap min">
        <% var motto = "二人には夢があった 今は凍りついた花。"; %>
        <% var mottoLink = "https://music.163.com/#/song?id=3330074495"; // 点击座右铭打开的歌曲 %>
        <section class="home-title home-hero">
            <a href="/about-me" class="home-profile-link">
                <span class="home-avatar-ring"><img src="<%= theme.author_avatar %>" alt="Author Avatar" class="home-avatar"></span>
                <h1 class="home-name"><%= config.title %></h1>
            </a>

            <%# 座右铭（点击打开歌曲）：隐形的整句先占好位置，打字的文字叠在同一格里，打字时行高与可点区域不跳 %>
            <a class="home-motto" href="<%= mottoLink %>" target="_blank" rel="noopener" aria-label="<%= motto %>（在网易云音乐中收听）">
                <span class="home-motto-ghost" aria-hidden="true"><%= motto %></span>
                <span class="home-motto-text" aria-hidden="true"></span>
            </a>

            <script>
                (function() {
                    var text = <%- JSON.stringify(motto) %>;
                    var container = document.querySelector(".home-motto-text");
                    var i = 0;
                    function typeWriter() {
                        if (i < text.length) {
                            container.textContent += text.charAt(i);
                            i++;
                            setTimeout(typeWriter, 120);
                        } else {
                            container.classList.add("is-done");
                        }
                    }
                    setTimeout(typeWriter, 900); // 等入场动画走到座右铭再开始
                })();
            </script>

            <%- partial("_partial/social") %>
        </section>
        <%- partial("_partial/archive-list") %>
        <section class="page-navigator">
            <%- paginator({
                prev_text: "«",
                next_text: "»"
            }) %>
        </section>
    </div>
</main>
<% if (theme.todo && theme.todo.enable) { %>
<%- partial("_partial/todo-sidebar") %>
<script src="<%- asset_url('static/todo-sidebar.js') %>"></script>
<% } %>
<script src="<%- asset_url('static/water-ripple.js') %>"></script>
<%# Gizmo 入口：浮在右侧水面上的叶片（顶栏导航收起时隐藏，入口改在导航卡片里）；运动与水波交互见 gizmo-leaf.js %>
<a class="gizmo-leaf" href="<%- url_for('/gizmo/') %>" aria-label="Gizmo：随手做的小玩意">
    <span class="gizmo-leaf-float">
        <span class="gizmo-leaf-body">
            <%- partial("_partial/gizmo-leaf-svg") %>
        </span>
    </span>
    <span class="gizmo-leaf-tag">Gizmo</span>
</a>
<script src="<%- asset_url('static/gizmo-leaf.js') %>"></script>
<% if ((site.data.backgrounds || []).length) { %>
<%# 首页背景切换：顶栏下方右上角的按钮 + 浮层（顶栏导航收起时隐藏，入口改在导航卡片里，见 header.ejs）；逻辑见 glint.js setupBgSwitch %>
<button type="button" class="bg-switch" aria-label="切换首页背景" aria-controls="bg-picker" aria-expanded="false"></button>
<%# 浮层从按钮本身长出来（corner-morph：起点与按钮同位置、同大小、同底色，按钮叠在上面不动），见 glint.css「首页右上角浮层」 %>
<div class="bg-picker corner-morph" id="bg-picker" inert aria-hidden="true">
    <div class="corner-morph-inner">
        <div class="bg-tiles" role="radiogroup" aria-label="首页背景"><%- partial("_partial/bg-tiles") %></div>
    </div>
</div>
<% } %>
<%# 首页轻音乐：右上角最上方的竖排胶囊（上播放 / 暂停、下「…」选曲），背景按钮在它下方，选曲浮层同背景浮层；顶栏导航收起时入口在导航卡片里（header.ejs）；逻辑见 glint.js setupHomeMusic %>
<div class="music-dock" role="group" aria-label="首页音乐">
    <button type="button" class="music-play" aria-label="播放音乐" aria-pressed="false"></button>
    <button type="button" class="music-more" aria-label="选择音乐" aria-controls="music-picker" aria-expanded="false"></button>
</div>
<div class="music-picker corner-morph" id="music-picker" inert aria-hidden="true">
    <div class="corner-morph-inner">
        <div class="music-list" role="radiogroup" aria-label="首页音乐"><%- partial("_partial/music-tracks") %></div>
    </div>
</div>
