<script>
    (function() {
        // 核心修复：把普通的博客文章 (is_post) 和独立页面 (is_page) 都视为"阅读界面"
        var isArticle = <%= (is_post() || is_page()) ? 'true' : 'false' %>;
        var isFromArticle = sessionStorage.getItem("is_from_article") === "true";
        var theme = sessionStorage.getItem("theme");

        // 0. 立即应用字体设置，避免字体闪烁
        try {
            var SETTINGS_KEY = "whatasiger_reader_settings";
            var savedSettings = JSON.parse(localStorage.getItem(SETTINGS_KEY));
            var fontChoice = (savedSettings && savedSettings.fontFamily) ? savedSettings.fontFamily : "noto-sans-sc";
            var sourceHanFontStack = '"Noto Sans SC", "Source Han Sans SC", "Source Han Sans CN", "Noto Sans CJK SC", "思源黑体", "思源黑体 CN", "Microsoft YaHei", sans-serif';
            var systemFontStack = 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif';
            document.body.style.fontFamily = fontChoice === "noto-sans-sc" ? sourceHanFontStack : systemFontStack;
            if (savedSettings && savedSettings.hideTodo) document.body.classList.add("hide-todo");
        } catch (e) {
            document.body.style.fontFamily = '"Noto Sans SC", "Source Han Sans SC", "Source Han Sans CN", "Noto Sans CJK SC", "思源黑体", "思源黑体 CN", "Microsoft YaHei", sans-serif';
        }

        // 0.1 背景可见度：与设置面板共用唯一数据源 whatasiger_reader_settings.bgOpacity
        var targetBgOpacity = 0.50; // 与 hingle.js defaultSettings.bgOpacity=35 对应
        var defaultBgOpacityValue = 50; // 默认档位（0~100），用于“从文章回首页”时重置
        try {
            var readerSettings = JSON.parse(localStorage.getItem("whatasiger_reader_settings"));
            if (readerSettings && typeof readerSettings.bgOpacity === "number") {
                var v = readerSettings.bgOpacity;
                if (v >= 0 && v <= 100) targetBgOpacity = v / 100;
            }
            // 从文章回到首页时：强制恢复为默认可见度，并写回设置
            if (!isArticle && isFromArticle) {
                targetBgOpacity = defaultBgOpacityValue / 100;
                if (readerSettings && typeof readerSettings === "object") {
                    readerSettings.bgOpacity = defaultBgOpacityValue;
                    try { localStorage.setItem("whatasiger_reader_settings", JSON.stringify(readerSettings)); } catch (e) {}
                }
            }
        } catch (e) {
            // 忽略错误，使用默认 0.35
        }

        // 0.2 背景模糊度：文章页使用用户保存值（默认8px），首页始终为0
        var DEFAULT_ARTICLE_BLUR = 8;
        var savedBlur = DEFAULT_ARTICLE_BLUR;
        try {
            if (readerSettings && typeof readerSettings.bgBlur === "number") {
                var bv = readerSettings.bgBlur;
                if (bv >= 0 && bv <= 20) savedBlur = bv;
            }
        } catch (e) {}
        // 目标模糊度：文章页=用户设置，首页=0
        var targetBgBlur = isArticle ? savedBlur : 0;
        // 初始（瞬间）模糊度：来自文章页则从 savedBlur 开始，便于过渡动画
        var initialBgBlur = isFromArticle ? savedBlur : 0;
        // 文章→文章时 initialBgBlur == targetBgBlur，rAF 不触发动画

        // 1. 初始状态：全面封印动画，防止页面刚加载时的任何闪烁
        document.body.classList.add("no-bg-transition");

        // 1.1 立即设置背景可见度和模糊度（封印状态，无动画）
        document.body.style.setProperty("--bg-opacity", String(targetBgOpacity));
        document.body.style.setProperty("--bg-blur", initialBgBlur + "px");

        // 2. 瞬间敲定日夜模式
        if (theme === "light") {
            document.body.classList.remove("dark-theme");
        } else {
            document.body.classList.add("dark-theme");
            sessionStorage.setItem("theme", "dark");
        }

        // 3. 敲定刚进网页瞬间的背景状态
        if (isArticle && isFromArticle) {
            // 阅读页跳阅读页：瞬间淡化
            document.body.classList.add("bg-faded");
        } else if (!isArticle && isFromArticle) {
            // 阅读页跳主页：必须先瞬间淡化，为后面的淡出动画做准备
            document.body.classList.add("bg-faded");
        }

        // 4. 更新记忆，留给下一次跳转使用
        sessionStorage.setItem("is_from_article", isArticle ? "true" : "false");

        // 5. 释放封印，并触发需要的丝滑动画
        requestAnimationFrame(function() {
            requestAnimationFrame(function() {
                // 解除动画封印
                document.body.classList.remove("no-bg-transition");

                // 背景可见度：与设置面板统一，不再在跳转时覆盖为固定值，保持当前 targetBgOpacity 即可
                document.body.style.setProperty("--bg-opacity", String(targetBgOpacity));

                // 背景模糊度：设置目标值，触发平滑过渡
                // 文章→文章时 initialBgBlur == targetBgBlur，此处赋值无变化，不触发动画
                document.body.style.setProperty("--bg-blur", targetBgBlur + "px");

                // 触发跨界面的过渡动画（保留原有逻辑）
                if (isArticle && !isFromArticle) {
                    // 主页跳阅读页：此时开始平滑变淡
                    document.body.classList.add("bg-faded");
                } else if (!isArticle && isFromArticle) {
                    // 阅读页跳主页：此时开始平滑变清晰
                    document.body.classList.remove("bg-faded");
                }
            });
        });
    })();
</script>
<header>
    <a href="<%- url_for() %>" class="header-logo">Whatasiger - Ciel</a>
    <div class="head-title">
        <a href="<%- url_for() %>" style="text-decoration: none; color: inherit; display: block; width: 100%; height: 100%;">
            <h4><%= config.title %></h4>
        </a>
    </div>
    <div class="head-action">
        <div class="toggle-btn"></div>
        <div class="light-btn"></div>
        <div class="settings-btn"></div>
        <% if (!is_post()) { %>
            <div class="search-btn"></div>
        <% } %>
    </div>

    <% if (!is_post()) { %>
        <div class="head-search">
            <input type="text" id="local-search-input" name="s" placeholder="标题 / 标签 / 正文">
            <div id="local-search-result"></div>
        </div>
    <% } %>

    <div class="settings-panel" id="reader-settings-panel">
        <div class="settings-panel-inner">
            <div class="settings-panel-header">
                <span class="settings-panel-title">阅读设置</span>
                <span class="settings-panel-hint"></span>
            </div>
            <div class="settings-panel-body">
                <%# 界面主题：切到 Glint 会跳到 Glint 界面的同一页（见 _partial/ui-switch.ejs） %>
                <label class="settings-row">
                    <span>界面</span>
                    <select id="setting-ui" onchange="window.switchUI && window.switchUI(this.value)">
                        <option value="glint">Glint</option>
                        <option value="origin" selected>Origin</option>
                    </select>
                </label>
                <label class="settings-row">
                    <span>显示「回到顶部」</span>
                    <input type="checkbox" id="setting-show-top">
                </label>
                <label class="settings-row">
                    <span>隐藏背景图片</span>
                    <input type="checkbox" id="setting-hide-bg">
                </label>
                <label class="settings-row">
                    <span>关闭首页 TODO 显示</span>
                    <input type="checkbox" id="setting-hide-todo">
                </label>
                <label class="settings-row">
                    <span>字体</span>
                    <select id="setting-font-family">
                        <option value="noto-sans-sc">思源黑体</option>
                        <option value="system-default">系统默认</option>
                    </select>
                </label>
                <div class="settings-group-title">文字设置 仅在文章页对正文生效</div>
                <label class="settings-row settings-row-range">
                    <span>字重</span>
                    <input type="range" id="setting-font-weight" min="1" max="5" step="1">
                </label>
                <label class="settings-row settings-row-range">
                    <span>字间距</span>
                    <input type="range" id="setting-letter-spacing" min="-2" max="8" step="1">
                </label>
                <label class="settings-row settings-row-range">
                    <span>字号</span>
                    <input type="range" id="setting-font-size" min="90" max="130" step="10">
                </label>
                <div class="settings-group-title">背景</div>
                <label class="settings-row settings-row-range">
                    <span>背景可见度</span>
                    <input type="range" id="setting-bg-opacity" min="0" max="50" step="2.5">
                </label>
                <label class="settings-row settings-row-range settings-row-range-rtl">
                    <span>背景模糊度</span>
                    <input type="range" id="setting-bg-blur" min="0" max="20" step="1">
                </label>
            </div>
            <div class="settings-panel-footer">
                <button id="setting-reset-btn" class="settings-reset-btn">重置</button>
            </div>
        </div>
    </div>

</header>
<nav class="head-menu">
    <a href="<%= url_for() %>">首页</a>
    <% for (var i in theme.menu){ %>
        <a href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
    <% } %>
</nav>
