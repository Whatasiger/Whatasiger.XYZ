<main>
    <div class="wrap min">
        <section class="home-title">
            <a href="<%- url_for('/about-me') %>" class="home-profile-link" style="text-decoration: none; color: inherit; display: inline-block; text-align: center;">
                <img src="<%= theme.author_avatar %>" alt="Author Avatar" class="home-avatar" style="width: 110px; height: 110px; border-radius: 50%; margin: 0 auto 1.5em; display: block; box-shadow: 0 4px 15px rgba(0,0,0,0.15);">
                <h1><%= config.title %></h1>
            </a>

            <div style="display: block; margin-bottom: 0.4em;">
                <span id="typewriter-text" style="display: inline-block; min-height: 1.5em; border-right: 2px solid var(--blue); padding-right: 4px; font-style: normal;"></span>
            </div>

            <script>
                (function() {
                    const text = "二人には夢があった 今は凍りついた花。";
                    const container = document.getElementById("typewriter-text");
                    let i = 0;
                    function typeWriter() {
                        if (i < text.length) {
                            container.innerHTML += text.charAt(i);
                            i++;
                            setTimeout(typeWriter, 120);
                        }
                    }
                    setTimeout(typeWriter, 600);
                })();
            </script>

            <div style="display: block;">
                <%- partial("_partial/social") %>
            </div>
        </section>
        <%- partial("_partial/archive-list") %>
        <section class="page-navigator">
            <%- paginator({
                prev_text: "«",
                next_text: "»"
            }) %>
        </section>
    </div>
</main>
<% if (theme.todo && theme.todo.enable) { %>
<%- partial("_partial/todo-sidebar") %>
<script src="<%- url_for('/static/todo-sidebar.js') %>"></script>
<% } %>
<script src="<%- url_for('/static/glass-crack.js') %>"></script>
<script src="<%- url_for('/static/water-ripple.js') %>"></script>
